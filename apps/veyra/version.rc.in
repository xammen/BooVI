#include <windows.h>
#include "veyra-resource.h"
IDI_VEYRA ICON "@VEYRA_RESOURCE_ICON@"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "FileDescription", "@VEYRA_RESOURCE_DESCRIPTION@"
   VALUE "FileVersion", "@VEYRA_DISPLAY_VERSION@"
   VALUE "ProductName", "@VEYRA_RESOURCE_PRODUCT@"
   VALUE "ProductVersion", "@VEYRA_DISPLAY_VERSION@"
   VALUE "OriginalFilename", "@VEYRA_RESOURCE_FILENAME@"
   VALUE "LegalCopyright", "@VEYRA_RESOURCE_COPYRIGHT@"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
